.input {
    width: 100%;
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    border-width: 0;
}

.input > .unity-text-field__input {
    font-size: 13px;
    padding: 12px 16px;
    border-radius: 12px;
    border-width: 0;
    background-color: white;
    color: var(--color-grey-1);
}

.input > .unity-text-field__input:active {
    border-color: #b58be7;
}