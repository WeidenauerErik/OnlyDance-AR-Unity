.button-select {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-top: 5px;
}

.button {
    background-color: var(--color-violet-2);
    color: white;
    border-radius: 10px;
    font-size: 13px;
    border-width: 0;
    width: 100%;
}

.button-select > .button {
    width: 45%;
}

.button:active {
    background-color: var(--color-violet-3);
}

.button:disabled {
    color: var(--color-violet-2);
    background-color: var(--color-violet-1);
}


.dancePlayButton {
    background-image: resource("UIControllerPlayIcon");
    background-size: 30% 30%;
    border-radius: 50px;
}

.importJsonButton {
    background-image: resource("UIControllerImportIcon");
    border-radius: 5px;
    background-size: 50% 50%;
}

.dancePlayButton, .importJsonButton {
    background-color: var(--color-violet-2);
    background-repeat: no-repeat;
    background-position: center;
    padding: 5px;
    width: 30px;
    height: 30px;
}

.dancePlayButton:active, .importJsonButton:active {
    background-color: var(--color-violet-3);
}