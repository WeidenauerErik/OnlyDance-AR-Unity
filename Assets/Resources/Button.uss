.button-select {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-top: 5px;
}

.button {
    background-color: var(--color-violet-2);
    color: white;
    border-radius: 10px;
    font-size: 13px;
    border-width: 0;
    width: 100%;
}

.button-select > .button {
    width: 45%;
}

.button:active {
    background-color: var(--color-violet-3);
}

.button:disabled {
    color: var(--color-violet-2);
    background-color: var(--color-violet-1);
}