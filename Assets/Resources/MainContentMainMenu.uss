#mainContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
    background-color: var(--color-white-1);
    padding-right: 10px;
    padding-left: 10px;
}

.dance-container {
    border-radius: 10px;
    width: 100%;
    display: flex;
    flex-direction: column;
    margin-top: 30px;
}

.dance {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-violet-1);
    border-radius: 10px;
    margin: 3px;
    padding: 5px;
}

.heading-navbar {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}