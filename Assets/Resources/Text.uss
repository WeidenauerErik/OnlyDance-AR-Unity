.text-large {
    font-size: 22px;
    white-space: normal;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    width: 100%;
} 

.text-medium {
    font-size: 14px;
    white-space: normal;
    width: 100%;
}

.text-small {
    font-size: 8px;
    white-space: normal;
    width: 100%;
}

.switch-link {
    background-color: transparent;
    color: var(--color-violet-2);
    font-size: 12px;
    border-width: 0;
    margin-top: 15px;
}