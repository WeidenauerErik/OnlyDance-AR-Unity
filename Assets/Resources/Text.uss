.text-large {
    font-size: 22px;
    white-space: normal;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    min-width: 100px;
    width: auto;
}

.text-medium {
    font-size: 13px;
    white-space: normal;
}

.text-medium-grey-1 {
    font-size: 13px;
    color: var(--color-grey-1);
    padding: 0;
    margin: 0;
    white-space: normal;
}

.text-medium-grey-2 {
    font-size: 13px;
    color: var(--color-grey-1);
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: auto;
    width: 80%;
}

.text-small {
    font-size: 8px;
    white-space: normal;
    width: 100%;
}

.switch-link {
    width: auto;
    background-color: transparent;
    color: var(--color-violet-2);
    font-size: 13px;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.textfield {
    width: 100%;
}

.textfield:focus {
    border-color: black;
}