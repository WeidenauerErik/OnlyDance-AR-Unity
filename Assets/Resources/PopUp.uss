.popup-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.popup-container {
    background-color: var(--color-white-1);
    padding: 20px;
    border-radius: 10px;
    width: 300px;
    max-width: 80%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    display: flex;
}

.popup-inner-container {
    width: 100%;
}
