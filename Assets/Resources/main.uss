:root {
    --color-white-1: #f8f4fa;
    --color-grey-1: rgb(176, 170, 181);
    --color-violet-1: rgb(215, 194, 223);
    --color-violet-2: rgb(48, 0, 73);
    --color-violet-3: rgb(67, 36, 87);
}

.error-label {
    white-space: normal;
    color: #e53935;
    font-size: 12px;
    margin-top: 3px;
    width: 100%;
    -unity-text-align: middle-center;
}