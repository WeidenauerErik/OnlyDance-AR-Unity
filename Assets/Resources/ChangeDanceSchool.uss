#mainContent {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
    background-color: var(--color-white-1);
    padding-right: 10px;
    padding-left: 10px;
    flex-grow: 1;
}

.arrow-image {
    background-image: resource("ForwardIcon");
    background-size: 50% 50%;
}