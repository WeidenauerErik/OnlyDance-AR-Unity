unity-panel,
#root,
:root {
    background-color: var(--color-white-1);
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

#mainContainer {
    width: 100%;
    height: 100%;
}

.auth-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80%;
    margin: auto;
}

.switch-container {
    justify-content: center;
    align-items: center;
    flex-direction: row;
    margin-top: 15px;
}