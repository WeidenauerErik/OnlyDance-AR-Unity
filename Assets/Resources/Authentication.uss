unity-panel,
#root,
:root {
    background-color: var(--color-white-1);
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

#mainContainer {
    width: 100%;
    height: 100%;
}

.auth-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80%;
    min-height: 70%;
    background-color: var(--color-violet-1);
    border-radius: 15px;
    padding: 20px;
    margin: auto;
}
